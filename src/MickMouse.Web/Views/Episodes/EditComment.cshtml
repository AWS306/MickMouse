@model EditCommentViewModel
@{ ViewData["Title"] = "Edit your comment"; }
<nav class="breadcrumb" aria-label="Breadcrumb"><a asp-action="Index">The journal</a><span aria-hidden="true">/</span><a asp-action="Details" asp-route-id="@Model.EpisodeId">Back to the episode</a><span aria-hidden="true">/</span><span>Edit comment</span></nav>
<div class="narrow"><div class="page-heading"><div><p class="eyebrow">A second thought</p><h1>Edit your comment.</h1><p>On @Model.EpisodeTitle</p></div></div><div class="panel"><p class="small muted">Your editing window closes on @Model.EditUntilUtc.ToString("dd MMM yyyy, HH:mm") UTC.</p><form asp-action="EditComment" method="post">@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All"></div> }<input asp-for="EpisodeId" type="hidden" /><input asp-for="CommentId" type="hidden" /><input asp-for="Version" type="hidden" /><div class="field"><label asp-for="Text">Your comment</label><textarea asp-for="Text" rows="7" required maxlength="2000"></textarea><span asp-validation-for="Text"></span><span class="field-help">Keep it thoughtful. Up to 2,000 characters.</span></div><div class="button-row"><button class="button" type="submit">Save your changes</button><a class="button button-secondary" asp-action="Details" asp-route-id="@Model.EpisodeId">Cancel</a></div></form></div></div>
