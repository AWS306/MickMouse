@model RegisterViewModel
@{ ViewData["Title"] = "Join the journal"; }
<div class="auth-layout">
    <aside class="auth-story"><div><p class="eyebrow eyebrow-light">There is room for you here</p><h2>Good stories<br />find good company.</h2><p>Follow a show. Save a favourite. Add a thought of your own. A small account opens up a bigger conversation.</p></div><div class="sound-mark" aria-hidden="true">@for (var i = 0; i < 28; i++) { <i></i> }</div></aside>
    <section class="auth-form" aria-labelledby="register-title"><h1 id="register-title">Make yourself at home.</h1><p class="auth-intro">Create your listener account. A few details, then you are in.</p>
        <form asp-action="Register" method="post">@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All"></div> }<div class="field"><label asp-for="DisplayName"></label><input asp-for="DisplayName" autocomplete="nickname" required maxlength="70" minlength="2" placeholder="What should we call you?" /><span asp-validation-for="DisplayName"></span><span class="field-help">This name appears beside your comments.</span></div><div class="field"><label asp-for="Email">Email address</label><input asp-for="Email" type="email" autocomplete="username" required maxlength="254" placeholder="you@example.com" /><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Password"></label><input asp-for="Password" type="password" autocomplete="new-password" required minlength="12" maxlength="100" aria-describedby="password-help" /><span asp-validation-for="Password"></span><span id="password-help" class="field-help">At least 12 characters, with uppercase, lowercase, a number and a symbol.</span></div><div class="field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required /><span asp-validation-for="ConfirmPassword"></span></div><button class="button button-full" type="submit">Create my account <span aria-hidden="true">↗</span></button></form>
        <p class="auth-footer">Already have an account? <a asp-action="Login">Sign in</a>.</p>
    </section>
</div>
