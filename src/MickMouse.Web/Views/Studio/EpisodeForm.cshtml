@model EpisodeFormViewModel
@{ var editing = Model.Id > 0; var action = editing ? "EditEpisode" : "CreateEpisode"; ViewData["Title"] = editing ? "Edit episode" : "New episode"; }
<nav class="breadcrumb" aria-label="Breadcrumb"><a asp-action="Index">The studio</a><span aria-hidden="true">/</span><span>@ViewData["Title"]</span></nav>
<div class="page-heading"><div><p class="eyebrow">Your next recording</p><h1>@(editing ? "Give it another listen." : "Set the scene. Press record.")</h1><p>@(editing ? "Update the story, replace the recording, or give your episode a clearer introduction." : "Add your recording and the details that will help it find its listeners.")</p></div></div>
@if (Model.Podcasts.Count == 0)
{ <div class="empty-state"><h2>First, give your episode a home.</h2><p>Create a show before adding an episode. It only takes a title, a host, and a short introduction.</p><a class="button" asp-action="CreatePodcast">Create a show</a></div> }
else
{
    <div class="form-layout"><section class="panel"><form asp-action="@action" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All"></div> }<input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" /><div class="field"><label asp-for="PodcastId"></label><select asp-for="PodcastId" required><option value="">Choose a show</option>@foreach (var show in Model.Podcasts) { <option value="@show.Id">@show.Title</option> }</select><span asp-validation-for="PodcastId"></span></div><div class="field"><label asp-for="Title">Episode title</label><input asp-for="Title" required maxlength="160" placeholder="What will stay with the listener?" /><span asp-validation-for="Title"></span></div><div class="field"><label asp-for="Summary">About this episode</label><textarea asp-for="Summary" required maxlength="3000" rows="6" placeholder="Introduce the conversation, the questions, and the people involved."></textarea><span asp-validation-for="Summary"></span><span class="field-help">Up to 3,000 characters.</span></div><div class="form-grid"><div class="field"><label asp-for="Topic"></label><input asp-for="Topic" required maxlength="60" placeholder="A topic listeners can search" /><span asp-validation-for="Topic"></span></div><div class="field"><label asp-for="ReleaseDateUtc"></label><input asp-for="ReleaseDateUtc" type="date" asp-format="{0:yyyy-MM-dd}" required /><span asp-validation-for="ReleaseDateUtc"></span></div><div class="field"><label asp-for="DurationMinutes"></label><input asp-for="DurationMinutes" type="number" min="1" max="720" required /><span asp-validation-for="DurationMinutes"></span></div></div>
        @if (!string.IsNullOrEmpty(Model.ExistingMediaKey)) { <div class="media-current"><p><strong>A recording is attached.</strong><br /><span class="small">Choose a new file below to replace it.</span></p><a asp-controller="Episodes" asp-action="Details" asp-route-id="@Model.Id">Listen to the current recording ↗</a></div> }
        <div class="field"><label asp-for="Media"></label><input asp-for="Media" type="file" accept=".mp3,.wav,.ogg,.m4a,.mp4,.webm" data-max-bytes="26214400" required="@(!editing || string.IsNullOrEmpty(Model.ExistingMediaKey))" aria-describedby="media-help" /><span asp-validation-for="Media"></span><span id="media-help" class="field-help">MP3, WAV, OGG, M4A, MP4 or WebM. Maximum 25 MiB. Only upload recordings you have permission to share.</span></div><div class="field"><label asp-for="SourceUrl"></label><input asp-for="SourceUrl" type="url" maxlength="1000" placeholder="https://example.com/original-episode" /><span asp-validation-for="SourceUrl"></span><span class="field-help">Link to the original publisher when sharing a licensed excerpt.</span></div><div class="field"><label asp-for="MediaCredit"></label><textarea asp-for="MediaCredit" maxlength="1000" rows="3" placeholder="Creator, license and any edits to the recording"></textarea><span asp-validation-for="MediaCredit"></span></div><div class="field"><partial name="_CoverPicker" model="@Model.CoverKey" /><span asp-validation-for="CoverKey"></span></div><div class="callout"><p>Your episode will be submitted for admin review. Changes to a published episode also return it to review.</p></div><div class="form-footer button-row"><button class="button" type="submit">@(editing ? "Save episode for review" : "Submit episode for review") <span aria-hidden="true">↗</span></button><a class="button button-secondary" asp-action="Index">Cancel</a></div></form></section><aside class="form-aside"><img src="~/art/covers/trail.svg" width="300" height="230" alt="" /><h2>Help the right ears find it.</h2><p>Give listeners a clear idea of the conversation. A specific title and a useful introduction go a long way.</p><p>Your recording stays in your studio until an admin approves it for the journal.</p><p>Keep credits with the recording when sharing someone else's work.</p></aside></div>
}
