@model PodcastFormViewModel
@{ var editing = Model.Id > 0; var action = editing ? "EditPodcast" : "CreatePodcast"; ViewData["Title"] = editing ? "Edit show" : "Create a show"; }
<nav class="breadcrumb" aria-label="Breadcrumb"><a asp-action="Index">The studio</a><span aria-hidden="true">/</span><span>@ViewData["Title"]</span></nav>
<div class="page-heading"><div><p class="eyebrow">A home for your voice</p><h1>@(editing ? "A fresh page for your show." : "Start something worth hearing.")</h1><p>@(editing ? "Update the details that help listeners find their way to your show." : "Give your show a name, introduce the host, and tell listeners what to expect.")</p></div></div>
<div class="form-layout"><section class="panel"><form asp-action="@action" asp-route-id="@Model.Id" method="post">@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All"></div> }<input asp-for="Id" type="hidden" /><div class="field"><label asp-for="Title">Show title</label><input asp-for="Title" required maxlength="120" placeholder="A name that sounds like you" /><span asp-validation-for="Title"></span></div><div class="form-grid"><div class="field"><label asp-for="HostName"></label><input asp-for="HostName" required maxlength="100" placeholder="Who is behind the mic?" /><span asp-validation-for="HostName"></span></div><div class="field"><label asp-for="Topic"></label><input asp-for="Topic" required maxlength="60" placeholder="Technology, nature, ideas..." /><span asp-validation-for="Topic"></span><span class="field-help">A clear topic makes your show easier to discover.</span></div></div><div class="field"><label asp-for="Description">About the show</label><textarea asp-for="Description" required maxlength="1500" rows="5" placeholder="What brings you to the microphone?"></textarea><span asp-validation-for="Description"></span><span class="field-help">Up to 1,500 characters.</span></div><div class="field"><partial name="_CoverPicker" model="@Model.CoverKey" /><span asp-validation-for="CoverKey"></span></div><div class="form-footer button-row"><button class="button" type="submit">@(editing ? "Save show" : "Create show") <span aria-hidden="true">↗</span></button><a class="button button-secondary" asp-action="Index">Cancel</a></div></form></section><aside class="form-aside"><img src="~/art/covers/workshop.svg" width="300" height="230" alt="" /><h2>Make the introduction count.</h2><p>A useful title and a clear description help the right listeners find you.</p><p>Name the host people will hear. Choose a topic that describes the conversations you want to have.</p></aside></div>
