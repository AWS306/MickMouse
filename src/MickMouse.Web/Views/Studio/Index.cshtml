@model StudioViewModel
@{ ViewData["Title"] = "The studio"; }
<div class="page-heading"><div><p class="eyebrow">Behind the microphone</p><h1>The studio.</h1><p>Make room for your next good conversation. Manage your shows, recordings and the people listening.</p></div><div class="button-row"><a class="button button-secondary" asp-action="CreatePodcast">New show</a><a class="button" asp-action="CreateEpisode">New episode <span aria-hidden="true">+</span></a></div></div>
<div class="stats-grid"><div class="stat"><span class="stat-label">Episodes</span><div class="stat-value">@Model.Episodes.Count</div><span class="stat-note">Across @Model.Podcasts.Count shows</span></div><div class="stat"><span class="stat-label">Total listens</span><div class="stat-value">@Model.TotalPlays.ToString("N0")</div><span class="stat-note">Every curious pair of ears</span></div><div class="stat"><span class="stat-label">Comments</span><div class="stat-value">@(Model.CommentsUnavailable ? "—" : Model.TotalComments.ToString("N0"))</div><span class="stat-note">@(Model.CommentsUnavailable ? "Temporarily unavailable" : "Thoughts from your listeners")</span></div><div class="stat"><span class="stat-label">Followers</span><div class="stat-value">@Model.TotalSubscribers.ToString("N0")</div><span class="stat-note">Show subscriptions</span></div></div>
@if (Model.PendingCleanup > 0)
{ <div class="notice notice-error"><div><p>@Model.PendingCleanup deleted @(Model.PendingCleanup == 1 ? "episode needs" : "episodes need") another attempt to remove the associated media or comments. These episodes are hidden from listeners.</p><form asp-action="RetryCleanup" method="post"><button class="button button-small button-secondary" type="submit">Retry cleanup</button></form></div></div> }
@if (Model.CommentsUnavailable) { <div class="notice notice-error">Comment counts could not be loaded. Your episode list is still available.</div> }
<section aria-labelledby="studio-episodes"><div class="section-heading"><h2 id="studio-episodes">Your recordings <span class="count">@Model.Episodes.Count episodes</span></h2><a class="link-arrow" asp-action="CreateEpisode">Add an episode <span aria-hidden="true">↗</span></a></div>
    @if (Model.Episodes.Count > 0)
    { <p class="table-scroll-note">Swipe the table to see all details and actions.</p><div class="table-wrap" role="region" aria-label="Scrollable table" tabindex="0"><table class="data-table"><thead><tr><th scope="col">Episode / show</th><th scope="col">Released</th><th scope="col">Listens</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead><tbody>@foreach (var episode in Model.Episodes) { <tr><td><a class="table-title" asp-controller="Episodes" asp-action="Details" asp-route-id="@episode.Id">@episode.Title</a><span class="table-subtitle">@episode.Podcast?.Title · @episode.Topic</span></td><td>@episode.ReleaseDateUtc.ToString("dd MMM yyyy")</td><td>@episode.PlayCount.ToString("N0")</td><td><span class="badge @(episode.Status == EpisodeStatus.Pending ? "badge-pending" : episode.Status == EpisodeStatus.Rejected ? "badge-rejected" : "")">@episode.Status</span></td><td><div class="table-actions"><a asp-action="EditEpisode" asp-route-id="@episode.Id">Edit</a><a class="danger-link" asp-action="DeleteEpisode" asp-route-id="@episode.Id">Delete</a></div></td></tr> }</tbody></table></div><p class="small muted">New and edited episodes are reviewed by an admin before publication.</p> }
    else
    { <div class="empty-state"><p class="eyebrow">Start the recording</p><h2>Your next story starts here.</h2><p>Create a show, then add an episode with a recording and a few words to set the scene.</p><a class="button" asp-action="@(Model.Podcasts.Count == 0 ? "CreatePodcast" : "CreateEpisode")">@(Model.Podcasts.Count == 0 ? "Create your first show" : "Add your first episode")</a></div> }
</section>
<section aria-labelledby="studio-shows" class="section-space"><div class="section-heading"><h2 id="studio-shows">Your shows <span class="count">@Model.Podcasts.Count shows</span></h2><a class="link-arrow" asp-action="CreatePodcast">Start a new show <span aria-hidden="true">↗</span></a></div>
    @if (Model.Podcasts.Count > 0)
    { <p class="table-scroll-note">Swipe the table to see all details and actions.</p><div class="table-wrap" role="region" aria-label="Scrollable table" tabindex="0"><table class="data-table"><thead><tr><th scope="col">Show</th><th scope="col">Host</th><th scope="col">Topic</th><th scope="col">Episodes</th><th scope="col">Actions</th></tr></thead><tbody>@foreach (var show in Model.Podcasts) { <tr><td><span class="table-title">@show.Title</span></td><td>@show.HostName</td><td>@show.Topic</td><td>@Model.Episodes.Count(e => e.PodcastId == show.Id)</td><td><div class="table-actions"><a asp-action="CreateEpisode" asp-route-podcastId="@show.Id">Add episode</a><a asp-action="EditPodcast" asp-route-id="@show.Id">Edit show</a><a class="danger-link" asp-action="DeletePodcast" asp-route-id="@show.Id">Delete</a></div></td></tr> }</tbody></table></div> }
    else
    { <div class="empty-state compact"><h2>A home for your ideas.</h2><p>Your shows will appear here once you create the first one.</p></div> }
</section>
