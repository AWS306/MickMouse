@model DeleteEpisodeViewModel
@{ ViewData["Title"] = "Delete episode"; }
<nav class="breadcrumb" aria-label="Breadcrumb"><a asp-action="Index">The studio</a><span aria-hidden="true">/</span><span>Delete episode</span></nav>
<section class="confirmation-panel panel"><p class="eyebrow">Before you close this page</p><h1>Delete this episode?</h1><p class="muted">The episode will disappear from the journal. Its likes, comments, and uploaded recording will be removed.</p><div class="confirmation-detail"><strong>@Model.Episode.Title</strong><p>@Model.Episode.Podcast?.Title · @Model.Episode.ReleaseDateUtc.ToString("dd MMM yyyy") · @Model.Episode.PlayCount.ToString("N0") listens</p></div><div class="callout danger-callout"><p>This action cannot be undone.</p></div><form asp-action="DeleteEpisode" asp-route-id="@Model.Episode.Id" method="post">@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All"></div> }<div class="button-row"><button class="button button-danger" type="submit">Delete episode</button><a class="button button-secondary" asp-action="Index">Keep the episode</a></div></form></section>
