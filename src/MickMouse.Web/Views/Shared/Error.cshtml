@model ErrorViewModel
@{ ViewData["Title"] = Model.Title; }
<section class="error-page"><p class="eyebrow">A pause in the conversation</p><p class="error-code">@Model.StatusCode</p><h1>@Model.Title</h1><p>@Model.Message</p><div class="button-row"><a class="button" asp-controller="Episodes" asp-action="Index">Back to the journal <span aria-hidden="true">↗</span></a>@if (User.Identity?.IsAuthenticated != true) { <a class="button button-secondary" asp-controller="Account" asp-action="Login">Sign in</a> }</div>@if (!string.IsNullOrEmpty(Model.RequestId)) { <p class="small muted section-space">Reference: @Model.RequestId</p> }</section>
