@model AdminViewModel
@{
    ViewData["Title"] = "The editor's desk";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var topCount = Model.TopEpisodes.Count > 0 ? Math.Max(1L, Model.TopEpisodes.Max(e => e.PlayCount)) : 1L;
}
<div class="page-heading"><div><p class="eyebrow">Care for the conversation</p><h1>The editor's desk.</h1><p>Review new recordings, keep an eye on the journal, and help the right people get behind the mic.</p></div><a class="button button-secondary" asp-controller="Studio" asp-action="Index">Open the studio <span aria-hidden="true">↗</span></a></div>
<div class="stats-grid"><div class="stat"><span class="stat-label">Shows</span><div class="stat-value">@Model.TotalPodcasts</div><span class="stat-note">Across the journal</span></div><div class="stat"><span class="stat-label">Total listens</span><div class="stat-value">@Model.TotalPlays.ToString("N0")</div><span class="stat-note">Stories finding their audience</span></div><div class="stat"><span class="stat-label">Comments</span><div class="stat-value">@(Model.CommentsUnavailable ? "—" : Model.TotalComments.ToString("N0"))</div><span class="stat-note">@(Model.CommentsUnavailable ? "Temporarily unavailable" : "A growing conversation")</span></div><div class="stat"><span class="stat-label">Waiting for review</span><div class="stat-value">@Model.PendingEpisodes.Count</div><span class="stat-note">New or updated episodes</span></div></div>
@if (Model.CommentsUnavailable) { <div class="notice notice-error">Comment totals are temporarily unavailable. Other reports are still available.</div> }
<section aria-labelledby="review-title"><div class="section-heading"><h2 id="review-title">Ready for a listen <span class="count">@Model.PendingEpisodes.Count pending</span></h2></div>
    @if (Model.PendingEpisodes.Count > 0)
    { <p class="table-scroll-note">Swipe the table to see all details and actions.</p><div class="table-wrap" role="region" aria-label="Scrollable table" tabindex="0"><table class="data-table"><thead><tr><th scope="col">Episode / show</th><th scope="col">Host</th><th scope="col">Release date</th><th scope="col">Review</th></tr></thead><tbody>@foreach (var episode in Model.PendingEpisodes) { <tr><td><a class="table-title" asp-controller="Episodes" asp-action="Details" asp-route-id="@episode.Id">@episode.Title</a><span class="table-subtitle">@episode.Podcast?.Title · @episode.Topic</span></td><td>@episode.Podcast?.HostName</td><td>@episode.ReleaseDateUtc.ToString("dd MMM yyyy")</td><td><div class="table-actions"><a asp-controller="Episodes" asp-action="Details" asp-route-id="@episode.Id">Listen</a><form asp-action="Approve" asp-route-id="@episode.Id" method="post"><button type="submit">Approve</button></form><form asp-action="Reject" asp-route-id="@episode.Id" method="post" data-confirm="Reject this episode? It will remain in its creator's studio."><button class="danger-link" type="submit">Reject</button></form></div></td></tr> }</tbody></table></div> }
    else
    { <div class="empty-state compact"><h2>The desk is clear.</h2><p>No episodes are waiting for review. New submissions will appear here.</p></div> }
</section>
<section aria-labelledby="popular-title" class="section-space"><div class="section-heading"><h2 id="popular-title">The well-played pages</h2><a class="link-arrow" asp-controller="Episodes" asp-action="Index" asp-route-sort="popular">View popular episodes <span aria-hidden="true">↗</span></a></div>
    @if (Model.TopEpisodes.Count > 0)
    { <div class="panel">@for (var i = 0; i < Model.TopEpisodes.Count; i++) { var episode = Model.TopEpisodes[i]; <div class="chart-row"><span class="chart-rank">@((i + 1).ToString("00"))</span><div><div class="chart-name"><a asp-controller="Episodes" asp-action="Details" asp-route-id="@episode.Id">@episode.Title</a></div><meter class="chart-meter" min="0" max="@topCount" value="@episode.PlayCount" aria-label="Listens for @episode.Title">@episode.PlayCount listens</meter></div><span class="chart-count">@episode.PlayCount.ToString("N0") listens</span></div> }</div> }
    else
    { <p class="muted small">Published episodes will appear here as the journal grows.</p> }
</section>
<section aria-labelledby="users-title" class="section-space"><div class="section-heading"><h2 id="users-title">The people behind the pages <span class="count">@Model.Users.Count accounts</span></h2></div><p class="small muted">New accounts start as listeners. Give a creator the Podcaster role when they are ready to publish.</p><p class="table-scroll-note">Swipe the table to see all details and actions.</p><div class="table-wrap" role="region" aria-label="Scrollable table" tabindex="0"><table class="data-table"><thead><tr><th scope="col">Person</th><th scope="col">Account</th><th scope="col">Role</th><th scope="col">Access</th></tr></thead><tbody>@foreach (var person in Model.Users) { var isCurrent = currentUserId == person.Id.ToString(); <tr><td><span class="table-title">@person.DisplayName</span><span class="table-subtitle">@person.Email</span></td><td><span class="badge @(person.IsDisabled ? "badge-rejected" : "")">@(person.IsDisabled ? "Disabled" : "Active")</span>@if (isCurrent) { <span class="table-subtitle">Your account</span> }</td><td>@if (isCurrent) { <span>@person.Role</span> } else { <form class="inline-role-form" asp-action="ChangeRole" method="post"><input type="hidden" name="userId" value="@person.Id" /><select class="account-roles" name="role" aria-label="Role for @person.DisplayName">@foreach (var role in Enum.GetValues<AccountRole>()) { <option value="@role" selected="@(person.Role == role)">@role</option> }</select><button class="button button-secondary button-small" type="submit">Save</button></form> }</td><td>@if (!isCurrent) { <form asp-action="ToggleUser" method="post" data-confirm="@(person.IsDisabled ? "Enable this account?" : "Disable this account? The person will lose access to signed-in features.")"><input type="hidden" name="userId" value="@person.Id" /><button class="text-button" type="submit">@(person.IsDisabled ? "Enable account" : "Disable account")</button></form> } else { <span class="small muted">Current session</span> }</td></tr> }</tbody></table></div></section>
